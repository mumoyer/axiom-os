{
  "name": "stage-gate-os",
  "description": "Stage Gate OS — The Autonomous Business Operating System",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:synthetic": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "build:client": "vite build client",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "node-fetch": "^3.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
