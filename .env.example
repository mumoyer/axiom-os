# ===================================================
# Axiom OS Production Environment Configuration
# ===================================================

# Server Runtime
NODE_ENV=production
PORT=3000

# CORS Allowed Origins (Comma-separated for multi-domain)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Stripe Payment & Webhook Configuration (Optional - Sandbox mocks active if omitted)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_TOLERANCE=31536000

# Stage-Gate Adapters & BYOK Vault
GITHUB_TOKEN=ghp_...
DNS_RESOLVER_TIMEOUT_MS=5000
CIRCUIT_BREAKER_FAIL_LIMIT=5
MAX_SELF_HEALING_RETRIES=3
